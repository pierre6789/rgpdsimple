# ── Variables d'environnement de l'API (backend) ──
# En local : copier ce fichier en .env et compléter.
# Sur Vercel : les coller dans Project (API) → Settings → Environment Variables.

# Stripe
STRIPE_SECRET_KEY=
# Secret du endpoint webhook (Stripe → Developers → Webhooks → ton endpoint → Signing secret)
STRIPE_WEBHOOK_SECRET=

# URLs
# APP_URL = URL publique de CETTE API (utilisée pour success_url Stripe).
#   Local: http://localhost:3000  |  Prod: https://<ton-projet-api>.vercel.app
APP_URL=http://localhost:3000
# APP_URL_FRONTEND = origine(s) du site React, séparées par des virgules (CORS + redirection après paiement).
#   Local: http://localhost:5173  |  Prod: https://rgpdsimple.fr,https://www.rgpdsimple.fr
APP_URL_FRONTEND=http://localhost:5173

# Email (SMTP ; ou API Mailtrap via MAILTRAP_API_TOKEN)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Optionnel : si défini, envoi via l'API HTTPS Mailtrap au lieu du SMTP
MAILTRAP_API_TOKEN=

# Email de contact affiché au client (page de confirmation)
SUPPORT_EMAIL=contact@rgpdsimple.fr

# Supabase (base de données des commandes)
# Supabase → Project Settings → API : Project URL + clé "service_role" (secrète, côté serveur uniquement)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Affiliation — Google Sheets (optionnel)
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── Côté FRONTEND (projet Vercel du site React) ──
# À définir dans le projet Vercel du frontend (pas ici) :
# VITE_API_URL=https://<ton-projet-api>.vercel.app
